# ── This app's own database (separate from Diakite's Postgres) ──────────────
# Use Vercel Postgres / Neon / Supabase — any Postgres connection string works.
DATABASE_URL="postgresql://user:password@host:5432/diakite_monitor"

# ── Diakite backend (the app you're monitoring) ──────────────────────────────
DIAKITE_API_BASE_URL="https://diakite.onrender.com"

# Credentials for the DEDICATED monitoring bot account — created once via
#   POST /api/admin/users/create-admin   (role: ADMIN, no adminDepartment)
# Never reuse a human admin's login here. These never reach the browser —
# they're only read server-side inside src/app/api/diakite/[...path]/route.ts
DIAKITE_MONITOR_EMAIL="monitor-bot@diakite.internal"
DIAKITE_MONITOR_PASSWORD="change-me-generate-a-long-random-password"

# ── This monitor app's own login ─────────────────────────────────────────────
# Named accounts now, not a shared password — create one with:
#   pnpm create-user -- --email=you@diakite.internal --name="Your Name" --password="..."
# See README.md for details. Only SESSION_SECRET is needed here.
SESSION_SECRET="generate-a-long-random-string-openssl-rand-hex-32"

# ── Alerting (optional — wire up when you're ready) ──────────────────────────
ALERT_EMAIL_TO=""
RESEND_API_KEY=""
TERMII_API_KEY=""
TERMII_SENDER_ID=""
ALERT_SMS_TO=""

# Vercel sets this automatically for Cron Jobs if you add it as an env var —
# generate your own value and Vercel will send it as a Bearer token when
# invoking /api/alerts/evaluate on schedule. Leave unset locally to test freely.
CRON_SECRET=""
